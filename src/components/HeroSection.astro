---
import type { Locale } from "../data/site";
import { contactInfo, locales } from "../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = locales[lang];
---

<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.title}</h1>
      <p class="hero-text">{content.hero.text}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={contactInfo.phoneTel}>{content.hero.phoneCta}</a>
        <a class="button button-secondary" href={contactInfo.emailHref}>{content.hero.emailCta}</a>
        <a class="button button-tertiary" href="#gallery">{content.hero.galleryCta}</a>
      </div>
    </div>
    <div class="hero-visual">
      <img
        src="/images/hero.jpg"
        alt="Industrial chimney installation with crane — 3P Kemeny"
        width="600"
        height="800"
      />
    </div>
  </div>
</section>
