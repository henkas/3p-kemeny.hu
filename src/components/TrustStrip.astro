---
import type { Locale } from "../data/site";
import { locales } from "../data/site";
import { trustBrandLogos } from "../data/logos";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = locales[lang];
---

<div class="trust-strip">
  <div class="shell">
    <div class="trust-strip-stats">
      {content.trustStrip.stats.map((stat) => (
        <div class="trust-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
    <div class="trust-strip-logos">
      {trustBrandLogos.map((brand) =>
        brand.hoverSrc ? (
          <span class="trust-logo-swap">
            <img class="trust-brand-logo default" src={brand.src} alt={brand.name} loading="lazy" />
            <img class="trust-brand-logo hover" src={brand.hoverSrc} alt={brand.name} loading="lazy" />
          </span>
        ) : (
          <img class="trust-brand-logo" src={brand.src} alt={brand.name} loading="lazy" />
        )
      )}
    </div>
  </div>
</div>
