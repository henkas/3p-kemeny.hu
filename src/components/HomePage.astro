---
import type { Locale } from "../data/site";
import HeroSection from "./HeroSection.astro";
import AboutSection from "./AboutSection.astro";
import ServicesSection from "./ServicesSection.astro";
import ReferencesSection from "./ReferencesSection.astro";
import GallerySection from "./GallerySection.astro";
import ContactSection from "./ContactSection.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<HeroSection lang={lang} />
<AboutSection lang={lang} />
<ServicesSection lang={lang} />
<ReferencesSection lang={lang} />
<GallerySection lang={lang} />
<ContactSection lang={lang} />
